# These environment keys are only for the local showdown CLI now.
# The static browser site takes keys from its keys panel, never from this file.
# ScaleDown API key. Sent as x-api-key. One of several readers in the model showdown.
SCALEDOWN_API_KEY=
# OpenRouter API key. Enables the Jev, Claude Haiku, Gemma and GPT-5.6 Luna lanes plus the referee models in the
# showdown (pnpm showdown). Without it those lanes are skipped and the rest still runs.
OPENROUTER_API_KEY=
# Optional: OpenAI Decisions API lane (gpt-6-luna) in the showdown
OPENAI_API_KEY=
# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=
